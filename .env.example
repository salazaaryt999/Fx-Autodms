# ==============================================================================
# FX Automate / WhatsApp Pro Suite Environment Variables Configuration
# ==============================================================================

# Server Network Configuration (Production-Ready for Render)
PORT=3000
HOST=0.0.0.0

# Optional Public/Render Domain for Webhook Callback
# On Render, RENDER_EXTERNAL_URL is automatically set to your https://service.onrender.com URL
# RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
# PUBLIC_URL=https://your-domain.com

# SQLite Persistent Data Directory (e.g. /var/data when using a Render persistent disk)
# DATA_DIR=./data

# Default Messaging Transport Mode:
# - 'web_qr' / 'local_whatsapp': Direct WhatsApp Web multi-device connection via QR Code
# - 'cloud_api': Official Meta WhatsApp Cloud API via Graph API
MESSAGING_MODE=web_qr

# ==============================================================================
# Official Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers (https://developers.facebook.com/apps/)
# ==============================================================================
WHATSAPP_API_VERSION=v22.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
