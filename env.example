# ==============================================================================
# FX Automate / WhatsApp Pro Suite Environment Variables Configuration
# ==============================================================================

# Server Port
PORT=3000

# Messaging Transport Mode:
# - 'local_whatsapp' / 'web_qr': Direct WhatsApp Web multi-device connection via QR Code
# - 'cloud_api': Official Meta WhatsApp Cloud API via Graph API
# - 'development': Local simulated sandbox mode (no real messages sent)
MESSAGING_MODE=local_whatsapp

# Local SQLite Database
DATABASE_URL=sqlite:///./data/app.db

# Local Offline AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==============================================================================
# Official Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers (https://developers.facebook.com/apps/)
# ==============================================================================
WHATSAPP_API_VERSION=v22.0
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=